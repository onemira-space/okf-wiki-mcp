  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "obsidian",
    "okf",
    "open-knowledge-format",
    "markdown",
    "meeting-notes",
    "voice-recorder",
    "local-ai",
    "claude-desktop",
    "claude-code",
    "cursor",
    "onemira"
  ]
}
