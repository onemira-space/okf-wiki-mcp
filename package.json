{
  "name": "okf-wiki-mcp",
  "mcpName": "io.github.onemira-space/okf-wiki-mcp",
  "version": "1.0.3",
  "description": "Zero-dependency offline Model Context Protocol (MCP) server & CLI for querying local Google OKF v0.2 and Obsidian Markdown meeting-notes vaults in Claude Desktop, Claude Code, Cursor & OneMira",
  "type": "module",
  "license": "MIT",
  "author": "OneMira Engineering (https://onemira.com)",
  "homepage": "https://onemira.com/docs/mcp-integration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onemira-space/okf-wiki-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/onemira-space/okf-wiki-mcp/issues"
  },
  "bin": {
    "okf-wiki-mcp": "bin/okf-wiki-mcp.mjs"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "SKILL.md",
    "server.json",
    "README.md",
    "LICENSE"
